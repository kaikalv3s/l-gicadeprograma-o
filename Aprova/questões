#include <iostream>
#include <algorithm>
#include <string>
#include <cctype>

using namespace std;

string ordenar(string palavra) {

    transform(
        palavra.begin(),
        palavra.end(),
        palavra.begin(),
        ::tolower
    );

    sort(
        palavra.begin(),
        palavra.end()
    );

    return palavra;
}

bool ehAnagrama(string alvo,
                string candidata) {

    string alvoOriginal = alvo;
    string candidataOriginal = candidata;

    transform(
        alvoOriginal.begin(),
        alvoOriginal.end(),
        alvoOriginal.begin(),
        ::tolower
    );

    transform(
        candidataOriginal.begin(),
        candidataOriginal.end(),
        candidataOriginal.begin(),
        ::tolower
    );

    if (alvoOriginal == candidataOriginal)
        return false;

    return ordenar(alvo) ==
           ordenar(candidata);
}

int main() {

    string alvo;
    int K;

    cout << "Palavra alvo: ";
    cin >> alvo;

    cout << "Quantidade de palavras: ";
    cin >> K;

    string palavra;

    cout << "\nAnagramas encontrados:\n";

    for (int i = 0; i < K; i++) {

        cin >> palavra;

        if (ehAnagrama(alvo, palavra)) {
            cout << palavra << endl;
        }
    }

    return 0;
}

