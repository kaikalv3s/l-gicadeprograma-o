#include <iostream>

using namespace std;

int main() {

    int N;

    cout << "Digite o tamanho da matriz: ";
    cin >> N;

    int **matriz = new int*[N];

    for (int i = 0; i < N; i++) {
        matriz[i] = new int[N];
    }

    int topo = 0;
    int baixo = N - 1;
    int esquerda = 0;
    int direita = N - 1;

    int valor = 1;

    while (topo <= baixo && esquerda <= direita) {

        for (int i = esquerda; i <= direita; i++)
            matriz[topo][i] = valor++;

        topo++;

        for (int i = topo; i <= baixo; i++)
            matriz[i][direita] = valor++;

        direita--;

        if (topo <= baixo) {
            for (int i = direita; i >= esquerda; i--)
                matriz[baixo][i] = valor++;

            baixo--;
        }

        if (esquerda <= direita) {
            for (int i = baixo; i >= topo; i--)
                matriz[i][esquerda] = valor++;

            esquerda++;
        }
    }

    cout << endl;

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cout << matriz[i][j] << "\t";
        }
        cout << endl;
    }

    for (int i = 0; i < N; i++) {
        delete[] matriz[i];
    }

    delete[] matriz;

    return 0;
}

