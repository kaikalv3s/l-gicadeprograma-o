#include <iostream>

using namespace std;

struct Produto {
    int codigo;
    char nome[50];
    int quantidade;
    float preco;
};

Produto maiorPreco(Produto *produtos, int n) {
    int indice = 0;

    for (int i = 1; i < n; i++) {
        if (produtos[i].preco > produtos[indice].preco) {
            indice = i;
        }
    }

    return produtos[indice];
}

Produto maiorEstoque(Produto *produtos, int n) {
    int indice = 0;

    for (int i = 1; i < n; i++) {
        if (produtos[i].quantidade > produtos[indice].quantidade) {
            indice = i;
        }
    }

    return produtos[indice];
}

int main() {

    int N;

    cout << "Quantidade de produtos: ";
    cin >> N;

    Produto *produtos = new Produto[N];

    for (int i = 0; i < N; i++) {

        cout << "\nProduto " << i + 1 << endl;

        cout << "Codigo: ";
        cin >> produtos[i].codigo;

        cout << "Nome: ";
        cin >> produtos[i].nome;

        cout << "Quantidade: ";
        cin >> produtos[i].quantidade;

        cout << "Preco: ";
        cin >> produtos[i].preco;
    }

    Produto p1 = maiorPreco(produtos, N);
    Produto p2 = maiorEstoque(produtos, N);

    cout << "\nProduto com maior preco:" << endl;
    cout << p1.nome << " - R$ " << p1.preco << endl;

    cout << "\nProduto com maior estoque:" << endl;
    cout << p2.nome << " - " << p2.quantidade << " unidades" << endl;

    delete[] produtos;

    return 0;

