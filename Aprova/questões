#include <iostream>
using namespace std;

const char* encontrar_primeira_ocorrencia(
    const char* principal, const char* procurada)
{
    while(*principal != '\0')
    {
        const char* p1 = principal;
        const char* p2 = procurada;
        
        while(*p1 != '\0' && *p2 != '\0' && *p1 == *p2)
        {
            p1++;
            p2++;
        }
        
        if (*p2 == '\0')
        {
            return principal;
        }
        principal++;
    }
    return nullptr;
} 

int main()
{
    const char* main_str = "programin in c++ is fun";
    const char* sub_str = "c++";
    
    const char* resultado = encontrar_primeira_ocorrencia(
    main_str, sub_str);
    
    if (resultado != nullptr)
    {
    cout<<"Substring encontrada iniciando em: "<<resultado<<endl;
    cout<<"String original a partir da ocorrência: "<<resultado;
    }
    
    return 0;
}

