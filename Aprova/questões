#include <iostream>
#include <fstream>
#include <iomanip>

using namespace std;

struct Aluno {
    char nome[50];
    float notas[5];
};

int main() {
    ifstream arquivo("notas.txt");

    if (!arquivo) {
        cout << "Erro ao abrir o arquivo!" << endl;
        return 1;
    }

    Aluno alunos[100];
    int qtd = 0;

    float somaTurma[5] = {0};

    while (arquivo >> alunos[qtd].nome) {

        float somaAluno = 0;

        for (int i = 0; i < 5; i++) {
            arquivo >> alunos[qtd].notas[i];

            somaAluno += alunos[qtd].notas[i];
            somaTurma[i] += alunos[qtd].notas[i];
        }

        cout << "Aluno: " << alunos[qtd].nome << endl;
        cout << fixed << setprecision(2);
        cout << "Media: " << somaAluno / 5 << endl << endl;

        qtd++;
    }

    cout << "----------------------------------" << endl;

    for (int i = 0; i < 5; i++) {
        cout << "Media da Nota " << i + 1 << ": "
             << somaTurma[i] / qtd << endl;
    }

    arquivo.close();

    return 0;
}

