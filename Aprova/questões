#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

struct Hole {
    int x;
    int y;
};

double distancia(Hole a, Hole b) {
    return sqrt(pow(a.x - b.x, 2) +
                pow(a.y - b.y, 2));
}

int main() {

    int N;
    cin >> N;

    Hole holes[1000];

    for (int i = 0; i < N; i++) {
        cin >> holes[i].x >> holes[i].y;
    }

    double menorDiametro = 1e18;

    for (int i = 0; i < N; i++) {

        double maiorDistancia = 0;

        for (int j = 0; j < N; j++) {

            double d = distancia(holes[i], holes[j]);

            if (d > maiorDistancia) {
                maiorDistancia = d;
            }
        }

        double raio = maiorDistancia + 2.5;
        double diametro = 2 * raio;

        if (diametro < menorDiametro) {
            menorDiametro = diametro;
        }
    }

    cout << fixed << setprecision(2)
         << menorDiametro << endl;

    return 0;
} 

