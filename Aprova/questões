#include <iostream>

using namespace std;

struct Ponto {
    float x;
    float y;
};

struct Retangulo {
    float xmin;
    float ymin;
    float xmax;
    float ymax;
};

int estaDentroRetangulo(Ponto p, Retangulo ret) {

    if (p.x >= ret.xmin &&
        p.x <= ret.xmax &&
        p.y >= ret.ymin &&
        p.y <= ret.ymax) {

        return 1;
    }

    return 0;
}

int main() {

    Retangulo ret;

    cout << "xmin ymin xmax ymax: ";
    cin >> ret.xmin >> ret.ymin
        >> ret.xmax >> ret.ymax;

    int N;

    cout << "Quantidade de pontos: ";
    cin >> N;

    Ponto *pontos = new Ponto[N];

    for (int i = 0; i < N; i++) {

        cout << "Ponto " << i + 1 << ": ";
        cin >> pontos[i].x >> pontos[i].y;
    }

    cout << endl;

    for (int i = 0; i < N; i++) {

        if (estaDentroRetangulo(pontos[i], ret)) {
            cout << "Ponto("
                 << pontos[i].x << ", "
                 << pontos[i].y
                 << "): SIM" << endl;
        }
        else {
            cout << "Ponto("
                 << pontos[i].x << ", "
                 << pontos[i].y
                 << "): NAO" << endl;
        }
    }

    delete[] pontos;

    return 0;
}

