#include <iostream>

using namespace std;

void multiplicacao(
    int **A,
    int **B,
    int **C,
    int m,
    int n,
    int p
) {
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {

            C[i][j] = 0;

            for (int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
}

int main() {

    int m, n, n2, p;

    cout << "Linhas de A: ";
    cin >> m;

    cout << "Colunas de A: ";
    cin >> n;

    int **A = new int*[m];

    for (int i = 0; i < m; i++) {
        A[i] = new int[n];
    }

    cout << "\nElementos da matriz A:\n";

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cin >> A[i][j];
        }
    }

    cout << "\nLinhas de B: ";
    cin >> n2;

    cout << "Colunas de B: ";
    cin >> p;

    if (n != n2) {

        cout << "Multiplicacao impossivel!" << endl;

        for (int i = 0; i < m; i++) {
            delete[] A[i];
        }

        delete[] A;

        return 0;
    }

    int **B = new int*[n2];

    for (int i = 0; i < n2; i++) {
        B[i] = new int[p];
    }

    cout << "\nElementos da matriz B:\n";

    for (int i = 0; i < n2; i++) {
        for (int j = 0; j < p; j++) {
            cin >> B[i][j];
        }
    }

    int **C = new int*[m];

    for (int i = 0; i < m; i++) {
        C[i] = new int[p];
    }

    multiplicacao(A, B, C, m, n, p);

    cout << "\nMatriz Resultante:\n";

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            cout << C[i][j] << " ";
        }
        cout << endl;
    }

    for (int i = 0; i < m; i++) {
        delete[] A[i];
    }
    delete[] A;

    for (int i = 0; i < n2; i++) {
        delete[] B[i];
    }
    delete[] B;

    for (int i = 0; i < m; i++) {
        delete[] C[i];
    }
    delete[] C;

    return 0;
}
