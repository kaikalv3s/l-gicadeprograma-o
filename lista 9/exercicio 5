#include <iostream>
#include <string>

using namespace std;

struct Aluno {
    string nome;
    int matricula;
    string curso;
};

int main() {
    Aluno alunos[5];

    for (int i = 0; i < 5; i++) {
        cout << "Aluno " << i + 1 << endl;

        cout << "Nome: ";
        getline(cin, alunos[i].nome);

        cout << "Matricula: ";
        cin >> alunos[i].matricula;
        cin.ignore();

        cout << "Curso: ";
        getline(cin, alunos[i].curso);

        cout << endl;
    }

    // Impressao dos dados
    cout << "\nDados dos alunos:\n";

    for (int i = 0; i < 5; i++) {
        cout << "Aluno " << i + 1 << endl;
        cout << "Nome: " << alunos[i].nome << endl;
        cout << "Matricula: " << alunos[i].matricula << endl;
        cout << "Curso: " << alunos[i].curso << endl;
        cout << endl;
    }

    return 0;
}
