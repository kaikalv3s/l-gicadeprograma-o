#include <iostream>
#include <string>
using namespace std;

struct Pessoa {
    string nome;
    string endereco;
    string telefone;
};

int main() {
    Pessoa pessoas[15];
    Pessoa temp;

    for(int i = 0; i < 15; i++) {
        cout << "Nome: ";
        getline(cin, pessoas[i].nome);

        cout << "Endereco: ";
        getline(cin, pessoas[i].endereco);

        cout << "Telefone: ";
        getline(cin, pessoas[i].telefone);
    }

    for(int i = 0; i < 14; i++) {
        for(int j = i + 1; j < 15; j++) {
            if(pessoas[j].nome < pessoas[i].nome) {
                temp = pessoas[i];
                pessoas[i] = pessoas[j];
                pessoas[j] = temp;
            }
        }
    }

    cout << "\nORDEM ALFABETICA\n";

    for(int i = 0; i < 15; i++) {
        cout << "\nNome: " << pessoas[i].nome << endl;
        cout << "Endereco: " << pessoas[i].endereco << endl;
        cout << "Telefone: " << pessoas[i].telefone << endl;
    }

    return 0;
}
