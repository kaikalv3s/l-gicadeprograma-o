#include <iostream>
#include <limits>

using namespace std;

struct Aluno {
    string nome;
    int matricula;
    float media;
};

int main() {

    Aluno alunos[10];
    Aluno aprovados[10];
    Aluno reprovados[10];

    int a = 0;
    int r = 0;

    for(int i = 0; i < 10; i++) {

        cout << "Nome: ";
        getline(cin, alunos[i].nome);

        cout << "Matricula: ";
        cin >> alunos[i].matricula;

        cout << "Media: ";
        cin >> alunos[i].media;

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        if(alunos[i].media >= 5) {
            aprovados[a] = alunos[i];
            a++;
        }
        else {
            reprovados[r] = alunos[i];
            r++;
        }
    }

    cout << "\nAPROVADOS\n";

    for(int i = 0; i < a; i++) {
        cout << aprovados[i].nome << endl;
    }

    cout << "\nREPROVADOS\n";

    for(int i = 0; i < r; i++) {
        cout << reprovados[i].nome << endl;
    }

    return 0;
}
