#include <iostream>
using namespace std;

int** somaMatrizes(int **A, int **B, int n)
{
    int **C = new int*[n];

    for (int i = 0; i < n; i++)
    {
        C[i] = new int[n];
    }

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            C[i][j] = A[i][j] + B[i][j];
        }
    }

    return C;
}

void liberarMatriz(int **matriz, int n)
{
    for (int i = 0; i < n; i++)
        delete[] matriz[i];

    delete[] matriz;
}

int main()
{
    int n;

    cout << "Digite o tamanho NxN: ";
    cin >> n;

    int **A = new int*[n];
    int **B = new int*[n];

    for (int i = 0; i < n; i++)
    {
        A[i] = new int[n];
        B[i] = new int[n];
    }

    cout << "\nDigite os elementos da matriz A:\n";
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << "A[" << i << "][" << j << "]: ";
            cin >> A[i][j];
        }
    }

    cout << "\nDigite os elementos da matriz B:\n";
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << "B[" << i << "][" << j << "]: ";
            cin >> B[i][j];
        }
    }

    int **C = somaMatrizes(A, B, n);

    cout << "\nMatriz soma (A + B):\n";
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cout << C[i][j] << " ";
        }
        cout << endl;
    }

    liberarMatriz(A, n);
    liberarMatriz(B, n);
    liberarMatriz(C, n);

    return 0;
}
