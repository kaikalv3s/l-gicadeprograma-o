#include <iostream>
using namespace std;

void lerVetor(int *vetor, int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << "Elemento [" << i << "]: ";
        cin >> *(vetor + i);
    }
}

int main()
{
    int n;

    cout << "Digite o tamanho do vetor: ";
    cin >> n;

    int *vetor = new int[n];

    lerVetor(vetor, n);

    cout << "\nVetor preenchido:\n";

    for (int i = 0; i < n; i++)
    {
        cout << *(vetor + i) << " ";
    }

    cout << endl;

    delete[] vetor;

    return 0;
}
