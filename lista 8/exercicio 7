#include <iostream>
#include <string>

using namespace std;

int main() {
    string texto;
    
    cout<<"Digite qualquer coisa: ";
    getline(cin, texto);

    for (int i = 0; i < texto.size(); i++) {

        if (texto[i] >= 'A' && texto[i] <= 'Z') {
            texto[i] = texto[i] + 32;
        }

        else if (texto[i] >= 'a' && texto[i] <= 'z') {
            texto[i] = texto[i] - 32;
        }
    }

    cout << texto;

    return 0;
}
