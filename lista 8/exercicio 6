#include <iostream>
#include <string>
using namespace std;

string alterar( string arquivo)
{
   int pos = arquivo.find('.');
   arquivo.replace(pos + 1, 3, "bmp");

    return arquivo;
}

int main()
{
    string arquivo;
    cout<<"Digite o nome do seu arquivo que contenha '.gif' no final: ";
    cin>>arquivo;
    cout<< alterar(arquivo);
    
    return 0;
}
