#include <iostream>
#include <string>
using namespace std;

bool polindromo(string palavra)
{
    int inicio = 0;
    int fim = palavra.length() - 1;
    
    while(inicio < fim)
    {
        if(palavra[inicio] != palavra[fim])
        {
            return false;
        }
        inicio++;
        fim--;
    }
    return true;
}

int main()
{
    
    string palavra;
    
    cout<<"Digite uma palavra: ";
    cin>>palavra;
    
    if (polindromo(palavra))
    {
        cout << "E um palindromo";
    } else{
        cout<<"Nao e um palindromo";
    }
    return 0;
}
