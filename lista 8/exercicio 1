#include <iostream>
#include <string>
using namespace std;

int main(){
    
    string palavra;
    int contador = 0;
    cout<<"Digite qualquer coisa ";
    getline (cin, palavra);
    
    for (int i = 0; i < palavra.length(); i++){
        if (palavra[i] == 'a'){
            palavra[i] = 'b';
            contador++;
        }
        
    }
    
    cout<<contador <<endl;
    cout<<palavra;
    
    return 0;
} 
